{
  "name": "dsh-code-block-quote",
  "version": "0.2.0",
  "description": "All-in-one Smart Quote Suite for DSH: code block quote button, BTW-style floating selection toolbar (main/side chat), collapsible cards, clean metadata, and permanent jump back. · DSH 全场景智能引用套件：代码块一键引用、全局划选悬浮药丸（发往主对话/侧边对话）、长引用自动折叠与乱码清洗、重开页面永久双向定位。",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "check": "node scripts/check-client.mjs && node scripts/check-roundtrip.mjs",
    "check:client": "node scripts/check-client.mjs",
    "check:roundtrip": "node scripts/check-roundtrip.mjs",
    "test:live": "node scripts/serve-test.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "code-block",
    "quote",
    "code-quote",
    "web-ui"
  ],
  "engines": {
    "dsh": ">=0.2.0-rc.2",
    "node": ">=18"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
